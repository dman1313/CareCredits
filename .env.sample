# PostgreSQL Configuration
POSTGRES_DB=carecredit
POSTGRES_USER=carecredit_user
POSTGRES_PASSWORD=carecredit_password
POSTGRES_PORT=5432

# Database Configuration for FastAPI
DB_NAME=carecredit
DB_USER=carecredit_user
DB_PASSWORD=carecredit_password
DB_PORT=5432

# Security Configuration
SECRET_KEY=your-super-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Application Configuration
APP_ENV=development

# Server-only Tavily credentials. Run python scripts/setup_tavily.py.
TAVILY_API_KEY=
# Separate bearer token protecting the paid discovery endpoint.
DISCOVERY_API_TOKEN=
